)


# July
july_ot_total = july_ot_feature["Total OT"].sum()
july_ot_employees = (
    july_ot_feature["Total OT"] > 0
).sum()

july_avg_ot = (
    july_ot_total / july_ot_employees
    if july_ot_employees > 0 else 0
)


