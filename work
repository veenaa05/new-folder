# Combine June and July overtime features

ot_features = pd.merge(
    june_ot_feature,
    july_ot_feature,
    on="Employee Code",
    how="outer"
)

# Employees without OT in one month are treated as 0 OT
ot_cols = [
    "Chargeable OT June",
    "Non Chargeable OT June",
    "Total OT June",
    "Chargeable OT",
    "Non Chargeable OT",
    "Total OT"
]

ot_features[ot_cols] = ot_features[ot_cols].fillna(0)

# OT change from June to July
ot_features["OT Change"] = (
    ot_features["Total OT"] - ot_features["Total OT June"]
)

print("Combined OT feature shape:", ot_features.shape)

display(ot_features.head(10))
